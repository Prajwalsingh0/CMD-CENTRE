# AI Command Center — environment template.
# Copy to .env and fill in real values. .env is git-ignored; never commit real secrets.

# ---------- Auth ----------
# HS256 signing key. MUST be at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-a-random-secret-of-at-least-32-bytes

# ---------- AI provider ----------
# local  = deterministic, credential-free provider (default, works offline)
# openai = any OpenAI-compatible /chat/completions + /embeddings endpoint
AI_PROVIDER=local
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Dimensions of the local hashed embedding (ignored when the provider supplies its own)
AI_EMBEDDING_DIMENSIONS=256

# ---------- Storage ----------
APP_STORAGE_LOCATION=./data/uploads
APP_MAX_FILE_SIZE_BYTES=8388608

# ---------- CORS ----------
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---------- Research agent ----------
# false => reports are explicitly marked as not web-grounded
RESEARCH_WEB_ENABLED=true

# ---------- Production datasource (profile: prod) ----------
DB_URL=jdbc:postgresql://localhost:5432/commandcenter
DB_USERNAME=commandcenter
DB_PASSWORD=change-me

# ---------- Misc ----------
SERVER_PORT=8080
